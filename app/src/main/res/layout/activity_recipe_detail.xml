<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Recipe title -->
        <TextView
            android:id="@+id/txtRecipeDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chicken Fried Rice"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp" />

        <!-- Ingredients heading -->
        <TextView
            android:id="@+id/txtIngredientsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="10dp" />

        <!-- Ingredients -->
        <TextView
            android:id="@+id/txtRecipeIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chicken - 200 g"
            android:textSize="17sp"
            android:textColor="?android:attr/textColorPrimary"
            android:lineSpacingExtra="6dp"
            android:padding="4dp"
            android:layout_marginBottom="28dp" />

        <!-- Preparation heading -->
        <TextView
            android:id="@+id/txtInstructionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="10dp" />

        <!-- Instructions -->
        <TextView
            android:id="@+id/txtRecipeInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation instructions will appear here."
            android:textSize="17sp"
            android:textColor="?android:attr/textColorPrimary"
            android:lineSpacingExtra="7dp"
            android:padding="4dp"
            android:layout_marginBottom="30dp" />

        <!-- Back button -->
        <Button
            android:id="@+id/btnBackFromRecipe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="←  Back"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>